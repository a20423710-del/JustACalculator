<Window x:Class="JustACalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JustACalculator"
        mc:Ignorable="d"
        Title="Calculator"
        Background="Black"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        MinWidth="320"
        MinHeight="420">
    <Window.Resources>
        <Style x:Key="CalcButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="MinWidth" Value="50" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#444444" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#222222" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- MaxHeightConverter removed; Equals now binds directly to Button0 height -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Display -->
            <RowDefinition Height="*" />
            <!-- Buttons area -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <!-- Main buttons -->
            <ColumnDefinition Width="1*" />
            <!-- Operators column -->
        </Grid.ColumnDefinitions>

        <!-- Display -->
        <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                 IsReadOnly="True"
                 Text="{Binding DisplayText, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="28"
                 FontWeight="Normal"
                 Foreground="#39FF14"
                 Background="Black"
                 BorderBrush="Gray"
                 Padding="8"
                 Margin="8"
                 HorizontalContentAlignment="Right"
                 VerticalContentAlignment="Center" />

        <!-- Main buttons grid (numbers and clears) -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Row 0 -->
            <Button x:Name="Button7" Grid.Row="0" Grid.Column="0" Style="{StaticResource CalcButtonStyle}" Content="7" Click="NumberButton_Click" />
            <Button x:Name="Button8" Grid.Row="0" Grid.Column="1" Style="{StaticResource CalcButtonStyle}" Content="8" Click="NumberButton_Click" />
            <Button x:Name="Button9" Grid.Row="0" Grid.Column="2" Style="{StaticResource CalcButtonStyle}" Content="9" Click="NumberButton_Click" />

            <!-- Row 1 -->
            <Button x:Name="Button4" Grid.Row="1" Grid.Column="0" Style="{StaticResource CalcButtonStyle}" Content="4" Click="NumberButton_Click" />
            <Button x:Name="Button5" Grid.Row="1" Grid.Column="1" Style="{StaticResource CalcButtonStyle}" Content="5" Click="NumberButton_Click" />
            <Button x:Name="Button6" Grid.Row="1" Grid.Column="2" Style="{StaticResource CalcButtonStyle}" Content="6" Click="NumberButton_Click" />

            <!-- Row 2 -->
            <Button x:Name="Button1" Grid.Row="2" Grid.Column="0" Style="{StaticResource CalcButtonStyle}" Content="1" Click="NumberButton_Click" />
            <Button x:Name="Button2" Grid.Row="2" Grid.Column="1" Style="{StaticResource CalcButtonStyle}" Content="2" Click="NumberButton_Click" />
            <Button x:Name="Button3" Grid.Row="2" Grid.Column="2" Style="{StaticResource CalcButtonStyle}" Content="3" Click="NumberButton_Click" />

            <!-- Row 3 (bottom row) -->
            <Button x:Name="Cancel" Grid.Row="3" Grid.Column="1" Style="{StaticResource CalcButtonStyle}" Content="C" Click="Cancel_Click" />
            <Button x:Name="ClearEntry" Grid.Row="3" Grid.Column="0" Style="{StaticResource CalcButtonStyle}" Content="CE" Click="ClearEntryButton_Click" />
            <Button x:Name="Button0" Grid.Row="3" Grid.Column="2" Style="{StaticResource CalcButtonStyle}" Content="0" Click="NumberButton_Click" />
            <Button x:Name="CommaButton" Grid.Row="3" Grid.Column="3" Style="{StaticResource CalcButtonStyle}" Content="," Click="NumberButton_Click" />
        </Grid>

        <!-- Operators column -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="8" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button x:Name="MultiplyButton" Grid.Row="0" Style="{StaticResource CalcButtonStyle}" Content="x" Click="MultiplyButton_Click" />
            <Button x:Name="DivideButton" Grid.Row="1" Style="{StaticResource CalcButtonStyle}" Content="/" Click="DivideButton_Click" />
            <Button x:Name="PlusButton" Grid.Row="2" Style="{StaticResource CalcButtonStyle}" Content="+" Click="PlusButton_Click" />
            <Button x:Name="MinusButton" Grid.Row="3" Style="{StaticResource CalcButtonStyle}" Content="-" Click="MinusButton_Click" />
            <Button x:Name="EqualsButton" Grid.Row="4" Style="{StaticResource CalcButtonStyle}" Content="=" Click="EqualsButton_Click" Margin="6,10,6,5" />
        </Grid>
    </Grid>
</Window>
